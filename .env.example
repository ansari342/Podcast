# Copy to .env.local for local dev. In production these live in Vercel → Project → Settings → Environment Variables.

# Sign-in (A1): one shared passcode for the three of you. Leave unset locally to skip sign-in.
STUDIO_PASSCODE=
AUTH_SECRET=            # long random string; signs the sign-in cookie

# LiveKit Cloud (S1): live call + data channel that keeps games, plan and recording in sync
LIVEKIT_URL=wss://<project>.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Cloudflare R2 (or any S3) (R3, L1): recordings upload here in 5-second chunks
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=studio-three-recordings
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
